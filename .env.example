# Book Recommender System — Environment Variables
# Copy this file to .env and fill in your values.
# All values shown here are the defaults used if not set.

# PostgreSQL (uncomment the postgres service to use)
POSTGRES_DB=library_db
POSTGRES_USER=library_user
POSTGRES_PASSWORD=library_pass
POSTGRES_PORT=5433

# Mailpit
MAILPIT_UI_PORT=2041
MAILPIT_SMTP_PORT=1025
MP_MAX_MESSAGES=500
MP_SMTP_AUTH_ACCEPT_ANY=true
MP_SMTP_AUTH_ALLOW_INSECURE=true

# ML Service
ML_SERVICE_PORT=2043
ML_INTERNAL_PORT=5000
ML_SERVICE_URL=http://ml-service:5000

BACKEND_PORT=2042
SPRING_PROFILES_ACTIVE=dev

# Database connection (used by Spring Boot)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/library_db

# Mail (leave blank to use Mailpit defaults)
SPRING_MAIL_HOST=mailpit
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# JWT — CHANGE THIS IN PRODUCTION!
JWT_SECRET=dGhpcyBpcyBhIHZlcnkgbG9uZyBhbmQgc2VjdXJlIGJhc2U2NCBlbmNvZGVkIHNlY3JldCBrZXkgZm9yIEpXVCBITUFDU0hBNTEy
JWT_EXPIRY_MS=86400000

# Initial admin account — CHANGE THESE IN PRODUCTION!
INITIAL_ADMIN_EMAIL=admin@library.com
INITIAL_ADMIN_PASSWORD=Admin@123

# Frontend origin allowed by the backend CORS config
FRONTEND_URL=http://localhost:2040

FRONTEND_PORT=2040
